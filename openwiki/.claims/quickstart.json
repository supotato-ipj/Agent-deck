    {
      "id": "claim_bafc3b01902843039869b2a546d368f9",
      "statement": "The developer loop is six npm scripts declared in `app/package.json` — `build` (two tsc programs plus `node scripts/copy-assets.mjs`), `dev` (build then `electron .`), `dev:panel` (build then `electron . --panel`), `accept` (build then `electron . --accept`), `typecheck` (no emit) and `test` (`vitest run`) — so no launch path starts Electron against a stale `dist`, while `npm test` runs against the TypeScript sources and needs no build.",
      "evidence": [
        {
          "resource": "repo://app/package.json#L7-L14",
          "version": "repo-lines-v1:sha256:1e9fd7b33eebbe125ac44b9ff81c5a5f3f8cf390ac5a9d995a444f0de57a69e1:"
        }
      ]
