        }
      ]
    },
    {
      "id": "claim_5744b934d7834d4ba674656380e94219",
      "statement": "Because window titles are unavailable, usage frequency is defined as real start count under time decay rather than foreground dwell time, the document zone may only be ordered by file modification time, and a process whose path cannot be mapped to a desktop icon is still logged but never ranked.",
      "evidence": [
        {
          "resource": "repo://docs/adr/0002-no-window-titles-in-usage-log.md#L10-L14",
          "version": "repo-lines-v1:sha256:365545ea5ba83018f73e246081a379c5ca3639e0cc1f85345a8c03c41361443e:"
        }
      ]
    },
