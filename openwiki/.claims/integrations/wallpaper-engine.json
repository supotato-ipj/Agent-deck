        }
      ]
    },
    {
      "id": "claim_f7657b3fb5e8476aad47c29c42fb2ba9",
      "statement": "Wallpaper Engine suspends the wallpaper page's timers while the desktop is occluded by a window, so polling and history curves pause and resume with desktop visibility; this behaviour is accepted rather than worked around.",
      "evidence": [
        {
          "resource": "repo://.scratch/qoder-deck/spec.md#L61-L61",
          "version": "repo-lines-v1:sha256:3e2f2dffd78a77492a5ac7efce98c9a36ba4b38965b76aed901b4de6afd740d6:"
