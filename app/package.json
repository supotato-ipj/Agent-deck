{
  "name": "agent-deck-panel",
  "version": "0.1.0",
  "private": true,
  "description": "AGENT DECK 独立面板（ADR-0004：Electron 窗口宿主 + cordis 内核）",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "dev": "npm run build && electron .",
    "accept": "npm run build && electron . --accept",
    "accept:tray": "npm run build && electron . --accept-tray",
    "accept:taskbar": "npm run build && electron . --accept-taskbar",
    "accept:taskbar-carry": "npm run build && electron . --accept-taskbar-carry",
    "accept:taskbar-right-group": "npm run build && electron . --accept-taskbar-right-group",
    "accept:taskbar-appbar": "npm run build && electron . --accept-taskbar-appbar",
    "dev:panel": "npm run build && electron . --panel"
  },
  "dependencies": {
    "cordis": "^3.18.1",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.4.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
